# 選用搜尋；複製為 .env.local 後按自己的配置修改，不提交真實憑證。
DAILY_SEARCH_PROVIDER=searxng
DAILY_SEARXNG_URL=http://127.0.0.1:8888
# 獨立 XNG AI Search Hub；沒有安裝 Hub 時請保持空白。
DAILY_XNG_HUB_URL=
# 下列只供自訂；不需要修改就沿用程式預設。
# DAILY_PORT=3210
# OLLAMA_HOST_URL=http://127.0.0.1:11435
# DAILY_TIMEZONE=Asia/Taipei
# Google Desktop OAuth 也可從介面匯入自己的 JSON。
# DAILY_GOOGLE_CLIENT_ID=
# DAILY_GOOGLE_CLIENT_SECRET=
# 真實 API key、Tunnel token、配對憑證、OAuth JSON 放在私人設定中。
